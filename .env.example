# Copy to .env and fill in. Never commit .env.
# Mode: backtest | paper | live
AITRADER_MODE=paper

# Live trading stays locked unless BOTH of these are set AND AITRADER_MODE=live.
# Do not change these until the Phase 6 go/no-go gate has passed.
AITRADER_LIVE_UNLOCKED=false
AITRADER_LIVE_CONFIRM=

# Where candles and paper state are stored
AITRADER_DB_PATH=data/aitrader.db

# Time zone the dashboard shows times in (IANA name). Data and schedules stay in UTC.
AITRADER_TZ=Asia/Kolkata

# Paper exchange settings
AITRADER_PAPER_START_USDT=10000
AITRADER_PAPER_TAKER_FEE=0.001
AITRADER_PAPER_MAKER_FEE=0.001
AITRADER_PAPER_SLIPPAGE_BPS=5
# Fee filter: skip a trade when fees + slippage of the round trip would cost more than this share
# of the risk (0.25 = a quarter). Stops very close to the entry (common on 5m) get skipped. 0 = off.
AITRADER_MAX_COST_R=0.25

# Symbols and timeframes for downloads/streams (comma separated)
AITRADER_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,TRX/USDT,LINK/USDT,AVAX/USDT,SUI/USDT,LTC/USDT,BCH/USDT,DOT/USDT,TON/USDT,NEAR/USDT,APT/USDT,UNI/USDT,AAVE/USDT,PEPE/USDT
AITRADER_TIMEFRAMES=1m,5m,15m,30m,1h,4h,1d
# Use the pair ranking (`aitrader pairs rank`) instead of AITRADER_SYMBOLS. A missing or stale
# ranking falls back to AITRADER_SYMBOLS. See docs/regime-and-pairs.md
AITRADER_PAIRS=fixed
AITRADER_PAIRS_TOP=20
AITRADER_PAIRS_MAX_AGE_HOURS=48

# Bybit only. Market data is public and needs no key. Easier: save keys on the dashboard's
# Settings page (stored encrypted) instead of here.
# Real account: shows the balance on the Trading page and is used by the live pilot. Read-Write,
# SPOT trade only, no withdrawals, transfers or contracts, bound to this server's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# The local AI model for the news brief (the `ollama` service; no key, nothing leaves the server).
# Any Ollama model name; the default is small enough for a 4 GB server. Downloaded on first use.
AITRADER_LOCAL_MODEL=qwen2.5:1.5b
# The local model that reads uploaded books into strategies, and the local hours it may run.
AITRADER_BOOK_MODEL=qwen2.5:3b
AITRADER_BOOK_HOURS=0-6

# Dashboard login (`aitrader web` / the `web` service). The dashboard will not start without a
# password of at least 12 characters. AITRADER_WEB_SECRET keeps people logged in across restarts
# (any long random string, e.g. from `openssl rand -hex 32`). Set AITRADER_WEB_SECURE_COOKIE=true
# when the dashboard is served over HTTPS.
AITRADER_WEB_USER=admin
AITRADER_WEB_PASSWORD=
AITRADER_WEB_SECRET=
AITRADER_WEB_SECURE_COOKIE=false
# Behind the caddy HTTPS proxy (deploy/install.sh sets these): what you type in the browser, the
# certificate (internal = Caddy's own, for a LAN IP; or your email for a Let's Encrypt
# certificate on a domain), and the address caddy listens on.
AITRADER_SITE=
AITRADER_TLS=internal
AITRADER_HTTPS_BIND=0.0.0.0
# The uid of the server user that owns ./data (`id -u`); the containers run with it.
AITRADER_UID=1000
# Backups (deploy/backup.sh): how many to keep, and an optional off-machine copy
# (another disk, or user@other-pc:/backups over rsync/ssh).
AITRADER_BACKUP_KEEP=14
AITRADER_BACKUP_COPY_TO=
# Daily backups leave the price candles out (they can be downloaded again); true copies them too
# (about 2 GB per year of history for 20 pairs, in every backup kept)
AITRADER_BACKUP_CANDLES=false

# ---- Phase 5: risk limits (every executor order is sized and checked by these) ----
# Risk per trade can never be set above 1% (0.01).
AITRADER_RISK_PER_TRADE=0.0025
AITRADER_DAILY_LOSS_PCT=0.01
AITRADER_WEEKLY_LOSS_PCT=0.05
AITRADER_MAX_OPEN_POSITIONS=3
AITRADER_MAX_COIN_EXPOSURE_PCT=0.25
AITRADER_MAX_TOTAL_EXPOSURE_PCT=0.9
AITRADER_MIN_ORDER_USDT=10
# coins that move together count as one group (groups separated by ;)
AITRADER_CORRELATION_GROUPS=BTC,ETH,SOL
AITRADER_MAX_GROUP_POSITIONS=2
AITRADER_MAX_GROUP_EXPOSURE_PCT=0.4

# Telegram alerts and commands (create a bot with @BotFather; docs/telegram.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Phase 6: go/no-go gate and the live pilot ----
AITRADER_GATE_MIN_PAPER_TRADES=100
AITRADER_GATE_MAX_DRAWDOWN_R=10
AITRADER_GATE_MAX_GAP_R=0.15
AITRADER_GATE_STABLE_DAYS=14
# The most USDT the live pilot may ever use (5-10% of what you plan to trade). Empty = no live.
AITRADER_PILOT_MAX_USDT=

# ---- User accounts (dashboard sign-up and per-user trading; docs/user-accounts.md) ----
# open = anyone who can reach the dashboard may create an account (you still approve each one).
AITRADER_WEB_SIGNUP=closed
# Encrypts users' exchange keys. At least 32 characters: `openssl rand -hex 32`. Back it up:
# if it is lost, every user must connect their keys again. Never change it while users have keys.
AITRADER_KEYS_SECRET=

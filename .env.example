# Copy to .env and fill in. Never commit .env.
# Mode: backtest | paper | testnet | live
AITRADER_MODE=paper

# Live trading stays locked unless BOTH of these are set AND AITRADER_MODE=live.
# Do not change these until the Phase 6 go/no-go gate has passed.
AITRADER_LIVE_UNLOCKED=false
AITRADER_LIVE_CONFIRM=

# Where candles and paper state are stored
AITRADER_DB_PATH=data/aitrader.db

# Paper exchange settings
AITRADER_PAPER_START_USDT=10000
AITRADER_PAPER_TAKER_FEE=0.001
AITRADER_PAPER_MAKER_FEE=0.001
AITRADER_PAPER_SLIPPAGE_BPS=5

# Symbols and timeframes for downloads/streams (comma separated)
AITRADER_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
AITRADER_TIMEFRAMES=1m,5m,15m,30m,1h,4h,1d

# Read-only keys are enough for Phase 1 (market data). Public data needs no key at all.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Binance Spot testnet keys (https://testnet.binance.vision)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

HTX_API_KEY=
HTX_API_SECRET=

# Lets the agent read books and draft strategies (`aitrader learn read`). Optional: everything
# else works without it. Get a key at https://console.anthropic.com. Only book text is sent.
ANTHROPIC_API_KEY=
AITRADER_LLM_MODEL=claude-sonnet-5-5

# Dashboard login (`aitrader web` / the `web` service). The dashboard will not start without a
# password of at least 12 characters. AITRADER_WEB_SECRET keeps people logged in across restarts
# (any long random string, e.g. from `openssl rand -hex 32`). Set AITRADER_WEB_SECURE_COOKIE=true
# when the dashboard is served over HTTPS.
AITRADER_WEB_USER=admin
AITRADER_WEB_PASSWORD=
AITRADER_WEB_SECRET=
AITRADER_WEB_SECURE_COOKIE=false
